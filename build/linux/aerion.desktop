[Desktop Entry]
Version=1.5
Type=Application
Name=Aerion
GenericName=Email
GenericName[ru]=Электронная почта
Comment=A modern, cross-platform email client
Comment[ru]=Современный кроссплатформенный почтовый клиент
Keywords=Mail;E-mail;email;IMAP;SMTP;CardDAV;
Keywords[ru]=Почта;Электронная почта;Письма;IMAP;SMTP;CardDAV;
Icon=io.github.hkdb.Aerion
TryExec=aerion
Exec=aerion %U
Terminal=false
Categories=Network;Email;
MimeType=x-scheme-handler/mailto;
StartupNotify=true
StartupWMClass=Aerion
X-GNOME-UsesNotifications=true
Actions=compose;

[Desktop Action compose]
Name=Compose New Email
Name[ru]=Написать письмо
Exec=aerion mailto:
